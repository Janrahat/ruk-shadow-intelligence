# ---------------------------------------------------------------------------
# RUK SHADOW INTELLIGENCE - example configuration
#
# Copy to .env and edit:   cp .env.example .env
# Never commit .env - it holds your secret and your salt.
# ---------------------------------------------------------------------------

# ----- runtime -------------------------------------------------------------
# development | production
# In production the app refuses to start with an insecure configuration.
RUK_ENV=development

# Exactly what visitors will type. Must be reachable from the internet for
# tracking links to work at all. A 127.0.0.1 value means links only work on
# this machine - the dashboard shows a warning when that is the case.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 0.0.0.0 exposes the port on every interface; 127.0.0.1 keeps it local.
BIND_HOST=127.0.0.1
BIND_PORT=8000

# ----- secrets -------------------------------------------------------------
# 64 hex characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If omitted in development a key is generated and stored in .ruk_secret
# (mode 0600). In production this variable is REQUIRED.
SECRET_KEY=

# Salt for IP hashing when IP_STORAGE_MODE=hashed.
# Defaults to the first 32 characters of SECRET_KEY if unset.
IP_HASH_SALT=

# ----- storage -------------------------------------------------------------
DATABASE_PATH=data/ruk.db

# How much of the visitor IP is kept. Choose the least you actually need.
#   full      - store the address as received
#   truncated - store it with the last part removed (203.0.113.0)
#   hashed    - store only a keyed one-way hash (cannot be reversed)
#   none      - store nothing
IP_STORAGE_MODE=full

# ----- geolocation ---------------------------------------------------------
# Approximate country/region only. This can never produce a street address.
#   none     - record nothing (fully offline, fully private)
#   maxmind  - local GeoLite2-City.mmdb; the IP never leaves this host
#   http     - an external API; the visitor IP leaves your server
GEO_PROVIDER=none
GEO_DB_PATH=
# Only used when GEO_PROVIDER=http. {ip} is replaced with the address.
# Example: GEO_HTTP_ENDPOINT=https://ip-api.com/json/{ip}?fields=status,country,regionName,city
GEO_HTTP_ENDPOINT=

# ----- tracking links ------------------------------------------------------
# true rejects plain-http destinations and http:// share URLs.
REQUIRE_HTTPS_LINKS=false

# Default retention for analytics rows, in days.
DEFAULT_RETENTION_DAYS=90

# How often the background sweeper deletes expired rows, in seconds.
RETENTION_SWEEP_SECONDS=3600

# Bump this when you change your privacy notice; old consents stop counting.
POLICY_VERSION=1.0

# ----- sessions ------------------------------------------------------------
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=3600

# Set true only behind a reverse proxy that you control, so X-Forwarded-For
# can be trusted. Leaving it false prevents visitors spoofing their address.
TRUST_PROXY_HEADERS=false

# ----- rate limiting -------------------------------------------------------
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW=300
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_WINDOW=60
